# Snoopy profile environment — copy to `.env` in this profile directory and fill
# in the values for THIS machine's owner. Secrets only; all behavior lives in
# config.yaml.

# ── Inference (OpenAI-compatible endpoint) ────────────────────────────────────
# Default: abliteration.ai. For a stub/self-hosted endpoint, change
# SNOOPY_MODEL_BASE_URL and set any non-empty ABLITERATION_API_KEY.
SNOOPY_MODEL_BASE_URL=https://api.abliteration.ai/v1
SNOOPY_MODEL=
ABLITERATION_API_KEY=

# ── Snoopy MCP server (per-user) ──────────────────────────────────────────────
# The owner's MCP deployment URL and bearer token (snoopy_key_...) issued by the
# Snoopy backend.
SNOOPY_MCP_URL=
SNOOPY_MCP_TOKEN=

# ── Optional: web tools ───────────────────────────────────────────────────────
# Any supported web-search credential works (e.g. TAVILY_API_KEY). Leave empty
# and web_search falls back to no-key providers or stays unavailable — the
# agent still works, only search/extract calls degrade.
# TAVILY_API_KEY=
