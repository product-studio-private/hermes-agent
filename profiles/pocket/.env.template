# Pocket profile environment — copy to `.env` in this profile directory and fill
# in the values for THIS machine's owner. Secrets only; all behavior lives in
# config.yaml.

# ── Inference (OpenAI-compatible endpoint) ────────────────────────────────────
# Default: abliteration.ai, model abliterated-model-large-v2. For a
# stub/self-hosted endpoint, change POCKET_MODEL_BASE_URL and set any
# non-empty ABLITERATION_API_KEY.
POCKET_MODEL_BASE_URL=https://api.abliteration.ai/v1
POCKET_MODEL=abliterated-model-large-v2
ABLITERATION_API_KEY=
